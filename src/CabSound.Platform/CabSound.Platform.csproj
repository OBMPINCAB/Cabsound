    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="2.1.10" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CabSound.Core\CabSound.Core.csproj" />
  </ItemGroup>
</Project>
